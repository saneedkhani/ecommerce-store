# Copy this file to .env and fill in your own values.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Comma-separated, e.g. example.com,www.example.com (leave empty for local development)
DJANGO_ALLOWED_HOSTS=

# Bank account shown to customers on the payment page
STORE_ACCOUNT_TITLE=ShopWave Pvt Ltd
STORE_ACCOUNT_NUMBER=PK00XXXX0000000000000000
STORE_BANK_NAME=Your Bank
